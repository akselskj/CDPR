import cv2
import numpy as np
import time
import camera as cam

cap = cam.CameraCapture(2)
prev_loop_time = time.perf_counter()
prev_frame = None
last_unique_time = time.perf_counter()
loop_fps = 0.0
cam_fps = 0.0
alpha = 0.1
flash_interval = 1.0
flash_duration = 0.1
next_flash_time = time.perf_counter() + flash_interval
flash_active = False
flash_end_time = 0
toggle_time = None

print("Automatic flash test running...")

while True:
    ret, frame = cap.read()  # only change: unpack (ret, frame)
    if not ret or frame is None:
        continue

    now = time.perf_counter()

    # ---- loop FPS ----
    dt_loop = now - prev_loop_time
    prev_loop_time = now
    if dt_loop > 0:
        loop_fps = (1 - alpha) * loop_fps + alpha * (1 / dt_loop)

    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

    # ---- detect new camera frame ----
    is_new = False
    if prev_frame is not None:
        diff = cv2.absdiff(gray, prev_frame)
        if np.mean(diff) > 1.0:
            is_new = True
    else:
        is_new = True

    if is_new:
        dt_cam = now - last_unique_time
        last_unique_time = now
        if dt_cam > 0:
            cam_fps = (1 - alpha) * cam_fps + alpha * (1 / dt_cam)
    prev_frame = gray

    # ---- automatic flash ----
    if now >= next_flash_time:
        toggle_time = time.perf_counter()
        flash_active = True
        flash_end_time = now + flash_duration
        next_flash_time = now + flash_interval

    if flash_active:
        flash = np.full((300, 500, 3), 255, np.uint8)
        cv2.imshow("flash", flash)
        if now >= flash_end_time:
            flash_active = False
            cv2.destroyWindow("flash")

    # ---- latency detection ----
    brightness = np.mean(gray)
    if brightness > 200 and toggle_time is not None:
        latency = (time.perf_counter() - toggle_time) * 1000
        print(f"Latency ≈ {latency:.1f} ms")
        toggle_time = None

    # ---- draw stats ----
    cv2.putText(frame, f"Loop FPS: {loop_fps:.1f}", (10, 30),
                cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)
    cv2.putText(frame, f"Cam FPS:  {cam_fps:.1f}", (10, 60),
                cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 255), 2)
    cv2.imshow("cam", frame)
    if cv2.waitKey(1) == 27:
        break

cap.release()
cv2.destroyAllWindows()