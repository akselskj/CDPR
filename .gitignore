# Exclude everything at root level
*

# Except .gitignore and CDPR_python/
!.gitignore
!CDPR_python/

# Allow all files inside CDPR_python
!CDPR_python/**

# But ignore these inside CDPR_python
CDPR_python/__pycache__/
CDPR_python/**/__pycache__/
CDPR_python/**/*.pyc
CDPR_python/**/*.mov
CDPR_python/**/*.avi
CDPR_python/**/*.mp4